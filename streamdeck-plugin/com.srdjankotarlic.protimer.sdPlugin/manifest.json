{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.srdjankotarlic.protimer",
  "Name": "ProTimer",
  "Version": "0.1.0.12",
  "Author": "Srdjan Kotarlic",
  "Description": "Optional local controller for ProTimer. Separate ACTIVE and SET, two timers, deliberate live-event controls and editable owned keys.",
  "Icon": "imgs/plugin",
  "Category": "ProTimer",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.6"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "Profiles": [
    {
      "Name": "profiles/protimer-xl-full",
      "DeviceType": 2,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": false
    }
  ],
  "Actions": [
    {
      "UUID": "com.srdjankotarlic.protimer.key",
      "Name": "ProTimer Key",
      "Icon": "imgs/action",
      "Tooltip": "Choose a ProTimer command. Configure and pair from ProTimer Control. Live actions use the authoritative timer, never keyboard emulation.",
      "PropertyInspectorPath": "ui/key.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ]
    }
  ]
}